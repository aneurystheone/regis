rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    
    function isAudio() {
      return request.resource.contentType.matches('audio/.*') || 
             request.resource.contentType == 'video/webm'; // Recorders often allow webm
    }
    
    function isSmallFile() {
      return request.resource.size < 5 * 1024 * 1024; // 5MB
    }

    // User Data Isolation
    // All user files must be in users/{userId}/...
    match /users/{userId}/{allPaths=**} {
      // Only the owner can read/write their files
      allow read, write: if isOwner(userId);
    }

    // Explicitly deny everything else to prevent leaks
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
