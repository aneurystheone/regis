rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      return request.auth.token.admin == true || request.auth.token.email == 'aneurystheone@gmail.com';
    }

    function isDemoTemplate(data) {
      return data.userId == 'DEMO_PROFILE_TEMPLATE';
    }

    
    // --- Collection-Specific Rules ---

    // 1. Teacher Profile
    match /teacher_profile/{uid} {
      allow read: if isSignedIn() && (uid == request.auth.uid || resource == null);
      allow write: if isOwner(uid);
    }
    
    // 2. Standard Shared Collections (By userId field)
    match /{collectionName}/{docId} {
      allow read: if isSignedIn() && (
        collectionName in ['classes', 'students', 'deleted_students', 'deleted_classes', 'instruments', 'anecdotes', 'user_competencies', 'journal', 'resources', 'custom_events', 'lesson_plans', 'grades', 'attendance'] &&
        (resource == null || resource.data.userId == request.auth.uid || isDemoTemplate(resource.data))
      );
      
      allow write: if isSignedIn() && (
        collectionName in ['classes', 'students', 'deleted_students', 'deleted_classes', 'instruments', 'anecdotes', 'user_competencies', 'journal', 'resources', 'custom_events', 'lesson_plans', 'grades', 'attendance'] &&
        (resource == null || resource.data.userId == request.auth.uid) &&
        (request.resource == null || request.resource.data.userId == request.auth.uid)
      );
    }
    
    // 3. Bulk Lists (Special document ID format)
    match /lists/{listDocId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (
        listDocId.contains(request.auth.uid) || 
        (resource != null && resource.data.userId == request.auth.uid)
      );
    }
    
    // Specific Rules for detailed control or exceptions
    
    // Users Collection (Private Profile)
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // App Configuration (Global AI Features)
    match /app_config/global_ai_features {
      // Everyone can read features (to respect settings)
      allow read: if true; 
      // Only admins can change them
      allow write: if isSignedIn() && isAdmin();
    }
  }
}
