# Environment variables for Firebase Functions (LOCAL DEVELOPMENT)
# Copy this to .env for local emulator testing

# Stripe Secret Key (Test Mode)
# STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Stripe Webhook Secret (Get from Stripe CLI or Dashboard)
# For local testing with Stripe CLI: stripe listen --forward-to http://localhost:5001/regis-dev/us-central1/stripeWebhook
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# App URL for redirects
APP_URL=http://localhost:5173
